APP_NAME=MarineCaddie
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Local XAMPP example: http://localhost/MarineCaddie
# Hostinger / live: https://indigo-jay-801538.hostingersite.com
APP_URL=http://localhost/MarineCaddie

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="ops@marinecaddie.com"
MAIL_FROM_NAME="${APP_NAME}"

# All website forms notify this inbox
FORM_NOTIFY_EMAIL=sunnyazahar@gmail.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Local XAMPP (project not using public/ as docroot):
# ASSET_URL="${APP_URL}/public"
# Hostinger (document root = public/): leave empty OR set to the live domain only
# ASSET_URL=https://indigo-jay-801538.hostingersite.com
ASSET_URL=

# Google reCAPTCHA — https://www.google.com/recaptcha/admin
# Classic v2: site + secret keys
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Enterprise (CreateAssessment) — https://cloud.google.com/recaptcha-enterprise/docs/create-assessment
RECAPTCHA_PROJECT_ID=
RECAPTCHA_API_KEY=
# Optional score threshold when Enterprise returns riskAnalysis.score (0.0–1.0)
RECAPTCHA_MIN_SCORE=0.5
