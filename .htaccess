<IfModule mod_rewrite.c>
    RewriteEngine On

    # IndexNow key — static plain text at web root (Bing rejects PHP/session responses)
    RewriteRule ^509b3b93b4e049619ce65b70e55997c8\.txt$ public/509b3b93b4e049619ce65b70e55997c8.txt [L]

    RewriteRule ^sitemap\.xml$ index.php [L]

    RewriteRule ^favicon\.ico$ public/favicon.ico [L]
    RewriteRule ^favicon-48x48\.png$ public/favicon-48x48.png [L]
    RewriteRule ^favicon-96x96\.png$ public/favicon-96x96.png [L]

    # Serve real files/dirs from /public (assets, etc.)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} ^/MarineCaddie/(assets|css|js|img|images|fonts|video)/(.*)$ [NC]
    RewriteRule ^(.*)$ public/$1 [L]

    # Shortcut: /MarineCaddie/assets/... -> public/assets/...
    RewriteRule ^assets/(.*)$ public/assets/$1 [L]

    # Front controller
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

DirectoryIndex index.php
